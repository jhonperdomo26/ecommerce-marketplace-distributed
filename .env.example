# Variables para docker-compose.prod.yml. Copia este archivo como ".env" (no se sube a Git).

# Contraseña de PostgreSQL (obligatoria).
DB_PASSWORD=cambia_esta_contraseña

# Secreto para firmar los tokens (obligatorio, >= 32 caracteres aleatorios):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Opcionales (valores por defecto):
# WEB_PORT=8080
# CORS_ORIGIN=http://localhost:8080
# LOGIN_RATE_LIMIT=10
# REGISTRO_RATE_LIMIT=20
# CHAT_RATE_LIMIT=60
# Documentación de la API: queda en http://localhost:8080/api/docs (API_DOCS=0 la apaga).
# API_DOCS=1

# Notificaciones por correo. Por defecto la API envía a Mailpit (bandeja en http://localhost:8025).
# Para un proveedor SMTP real:
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# SMTP_FROM=Comercio Electrónico <no-responder@ejemplo.com>
# MAILPIT_PORT=8025

# --- Solo para el despliegue en la nube (docker-compose.nube.yml) ---
# Dominio público. Sin comprar uno: la IP pública de la VM con guiones + .sslip.io
# DOMINIO=20-30-40-50.sslip.io
# Usuario y contraseña para ver la bandeja de Mailpit en https://correo.<DOMINIO>
# MAILPIT_UI_AUTH=demo:una_clave_larga
# Si se cambiaron las contraseñas de la semilla, la suite E2E necesita la nueva:
# E2E_CLAVE=
