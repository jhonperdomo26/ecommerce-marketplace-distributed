# Copia este archivo como .env y ajusta los valores a tu entorno.
# (Manual Técnico, Paso 2, punto 6)

PORT=3000

DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=comercio_electronico
# Máximo de conexiones del pool de pg (ver src/db.ts).
DB_POOL_MAX=30

# Debe coincidir con el valor usado al firmar los tokens.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Origen permitido por CORS (frontend web).
CORS_ORIGIN=http://localhost:5173

# --- Seguridad (Fase 4) ---
# En producción JWT_SECRET es obligatorio y debe tener >= 32 caracteres aleatorios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Detrás de un proxy inverso (nginx, balanceador) indica cuántos saltos hay, para que los
# límites de tasa usen la IP real del cliente:
# TRUST_PROXY=1
# Límites de tasa (valores por defecto entre paréntesis):
# LOGIN_RATE_LIMIT=10        # intentos de login por IP cada 15 min
# REGISTRO_RATE_LIMIT=20     # altas de cuenta por IP por hora
# CHAT_RATE_LIMIT=60         # mensajes de chat por IP por minuto

# --- Fase 2: documentación y notificaciones ---
# API_DOCS=0                 # apaga /api/docs y /api/openapi.json
# Correo (Nodemailer). Sin SMTP_HOST no se envía nada. Para desarrollo, Mailpit:
#   docker run -p 8025:8025 -p 1025:1025 axllent/mailpit   (bandeja en http://localhost:8025)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Comercio Electrónico <no-responder@comercio.local>
