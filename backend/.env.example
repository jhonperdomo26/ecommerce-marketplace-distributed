# Copia este archivo como .env y ajusta los valores a tu entorno.
# (Manual Técnico, Paso 2, punto 6)

PORT=3000

DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=comercio_electronico
# Máximo de conexiones del pool de pg (ver src/db.ts).
DB_POOL_MAX=30

# Debe coincidir con el valor usado al firmar los tokens.
JWT_SECRET=FirmaSecretaPlataforma

# Origen permitido por CORS (frontend web).
CORS_ORIGIN=http://localhost:5173
