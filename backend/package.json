{
  "name": "backend-ecommerce",
  "version": "1.0.0",
  "description": "API RESTful central de la plataforma de comercio electrónico (Manual Técnico, Sección 3)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed:hash": "ts-node-dev --transpile-only src/scripts/generarHash.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch"
  },
  "keywords": [
    "ecommerce",
    "marketplace",
    "express",
    "typescript"
  ],
  "author": "Juan Andrés Vidarte Dussan, Jhon Jairo Perdomo Perdomo, Julián Andrés Silva Morales",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
